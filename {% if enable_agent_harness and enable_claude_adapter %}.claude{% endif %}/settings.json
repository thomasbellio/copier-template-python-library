{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_config.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_git.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

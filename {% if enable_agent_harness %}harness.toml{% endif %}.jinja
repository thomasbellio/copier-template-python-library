# Agent harness settings. See docs/agent-harness.md.
# Agents must not edit this file to get a passing result; propose a change instead.

[harness]
default_branch = "{{ default_branch }}"
package = "{{ project_name }}"
# Python files under these directories are checked.
scope_dirs = ["src", "tests"]
# Text reports stop after this many findings; --json always lists all of them.
max_findings = 40

[ruff]
# Checked on changed code on top of the project's own Ruff selection.
# Thresholds live in pyproject.toml under [tool.ruff.lint.mccabe] and [tool.ruff.lint.pylint].
rules = [
  "C901",                                             # cyclomatic complexity
  "PLR0911", "PLR0912", "PLR0913", "PLR0915",         # size and shape
  "E722", "BLE001", "S110", "S112", "B904", "B012",   # exception hygiene
  "TRY002", "TRY203", "TRY400", "TRY401",
  "D100", "D101", "D102", "D103", "D104", "D106",     # docstring presence
]
# Preview-only in the pinned Ruff. Enabled for the harness run only, never project-wide.
preview_rules = ["PLR0904", "PLR0914", "PLR0916", "PLR0917", "PLR1702"]

[mypy]
# Extra command-line flags for the harness's mypy run. New projects keep strict settings in
# pyproject.toml, so this is empty. A retrofitted project that is not yet strict-clean puts
# the strict flags here instead, so they apply to changed code only:
#   flags = ["--strict", "--warn-unreachable", "--disallow-any-explicit",
#            "--enable-error-code", "ignore-without-code"]
flags = []

[vulture]
# Findings below this confidence are not reported at all.
min_confidence = 60
# At or above this confidence a finding blocks. Below it, only unused private names
# (leading underscore) block; unused public names are advisory.
block_confidence = 80

[pyscn]
# Import cycles allowed project-wide. Retrofitted projects set this to the current count
# and lower it as cycles are removed; it acts as a ratchet.
allowed_cycles = 0
# Coupling between objects: block a touched class coupled to more classes than this
# (the top of pyscn's default medium band).
max_cbo = 7
# LCOM4 bands, matching pyscn's defaults: above lcom_block_above is high risk and blocks;
# above lcom_advise_above is medium risk and is advisory.
lcom_block_above = 5
lcom_advise_above = 2
# Structural clone pairs at or above this similarity are reported as advisories.
clone_similarity = 0.80

[mutation]
# scripts/check.sh --mutation fails when more than this share of the executed mutants on
# changed lines survive. The CI job is advisory (continue-on-error) until the rate is stable.
max_survival_percent = 20

# Lefthook configuration
# See https://github.com/evilmartians/lefthook

pre-commit:
  parallel: false
  commands:
    build:
      run: uv run ./scripts/build.sh
      stage_fixed: true
{%- if enable_agent_harness %}

# Second net for commits made with --no-verify: re-check everything since the merge-base.
pre-push:
  commands:
    harness:
      run: uv run ./scripts/check.sh
{%- endif %}

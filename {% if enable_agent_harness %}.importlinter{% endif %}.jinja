# Architecture contracts, checked on the whole project by the agent harness (lint-imports).
# This file is owned by the project: add contracts as the package grows sub-packages.
# Agents must not edit it to make the gate pass. See https://import-linter.readthedocs.io

[importlinter]
root_packages =
    {{ project_name }}
    tests

[importlinter:contract:package-independent-of-tests]
name = The package never imports from the test suite
type = forbidden
source_modules =
    {{ project_name }}
forbidden_modules =
    tests


name: Pull Request Checks

on:
  pull_request:
    branches:
      - {{ default_branch }}

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["{{ python_version }}"]

    steps:
      - uses: actions/checkout@v4
{%- if enable_agent_harness %}
        with:
          # Full history, so the agent harness can find the merge-base with the target branch.
          fetch-depth: 0
{%- endif %}

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Set up Python {{ '${{ matrix.python-version }}' }}
        run: uv python install {{ '${{ matrix.python-version }}' }}

      - name: Install dependencies
        run: |
          uv venv
          uv pip install poetry
          uv run poetry install

{%- if enable_agent_harness %}

      - name: Find the merge-base for the agent harness
        run: echo "HARNESS_BASE=$(git merge-base HEAD origin/{{ '${{ github.base_ref }}' }})" >> "$GITHUB_ENV"

      - name: Flag agent harness configuration changes
        run: PYTHONPATH=scripts uv run python -m harness.ci_notice
{%- endif %}

      - name: Run build checks
        run: |
          uv run ./scripts/build.sh
{%- if enable_agent_harness %}

      - name: Summarise cognitive complexity changes
        if: always()
        run: |
          {
            echo "### Cognitive complexity changes (non-blocking)"
            echo
            echo '```'
            uv run complexipy src --diff-only "$HARNESS_BASE" --color no | sed -n '/Complexity diff/,$p'
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY" || true
{%- endif %}
{%- if enable_agent_harness %}

  # Mutation testing on changed lines. Advisory for now: make it required once the survival
  # rate on PRs is stable (see docs/agent-harness.md).
  mutation:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    continue-on-error: true

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install dependencies
        run: |
          uv venv
          uv pip install poetry
          uv run poetry install

      - name: Run mutation testing on changed lines
        run: |
          export HARNESS_BASE="$(git merge-base HEAD origin/{{ '${{ github.base_ref }}' }})"
          uv run ./scripts/check.sh --mutation
{%- endif %}

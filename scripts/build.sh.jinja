#!/bin/bash

set -e

echo "🔍 Running linting and formatting checks..."
ruff check .
ruff format --check .

echo "🔎 Running type checking..."
mypy src/{{ project_name }}

echo "🧪 Running tests..."
pytest
{%- if enable_agent_harness %}

echo "🧭 Running agent harness checks on changed code..."
./scripts/check.sh
{%- endif %}

echo "✅ All checks passed!"

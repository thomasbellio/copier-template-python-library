[project]
name = "{{ project_name }}"
requires-python=">=3.14"
version="0.0.1"
[tool.poetry]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
{%- if author_name %}
authors = ["{{ author_name }}{% if author_email %} <{{ author_email }}>{% endif %}"]
{%- endif %}
readme = "README.md"
packages = [{include = "{{ project_name }}", from = "src"}]

[tool.poetry.dependencies]
python = "^{{ min_python_version }}"

[tool.poetry.group.dev.dependencies]
pytest = "^9.0.2"
mypy = "^1.19.1"
ruff = "^0.14.14"
lefthook="2.0.15"
python-lsp-server = "^1.14.0"
{%- if enable_agent_harness %}
complexipy = { version = "^9.0.0", python = "<3.16" }  # upper bound is declared by complexipy
{%- endif %}

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"

[tool.ruff]
line-length = 100
target-version = "py{{ min_python_version.replace('.', '') }}"
indent-width = 2

[tool.ruff.lint]
select = [
  "E",   # pycodestyle errors
  "W",   # pycodestyle warnings
  "F",   # pyflakes
  "I",   # isort
  "B",   # flake8-bugbear
  "C4",  # flake8-comprehensions
  "UP",  # pyupgrade
{%- if enable_agent_harness %}
  # Agent harness rules; harness.toml lists the full set checked on changed code.
  "C901",    # cyclomatic complexity
  "PLR09",   # size and shape (stable pylint rules)
  "BLE001",  # blind except
  "S110",    # try-except-pass
  "S112",    # try-except-continue
  "TRY002",  # raise vanilla Exception
  "TRY203",  # useless try-except
  "TRY400",  # logging.error in handler
  "TRY401",  # verbose log message
  "D100",    # docstring presence: module
  "D101",    # class
  "D102",    # method
  "D103",    # function
  "D104",    # package
  "D106",    # nested class
{%- endif %}
]
ignore = [
  "E501",  # line too long, handled by formatter
  "B008",  # do not perform function calls in argument defaults
]
{%- if enable_agent_harness %}

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.pylint]
max-args = 5
max-returns = 6
max-branches = 12
max-statements = 50
max-positional-args = 5
{%- if docstring_style != "sphinx" %}

[tool.ruff.lint.pydocstyle]
convention = "{{ docstring_style }}"
{%- endif %}

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["PLR0913", "PLR0915", "PLR0917", "D", "S110"]
{%- endif %}

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "auto"

[tool.mypy]
python_version = "{{ min_python_version }}"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
strict_equality = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = [
  "--strict-markers",
  "--strict-config",
  "-ra",
]
